# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# ==================== DEPLOYMENT WALLET ====================
# Your private key (from MetaMask, Coinbase, etc.)
# ⚠️ CRITICAL: Only use testnet wallets! Never use mainnet funds!
PRIVATE_KEY=

# ==================== RPC ENDPOINTS ====================
# Ethereum Sepolia (testnet)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Base Sepolia (testnet) 
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base Mainnet (production)
BASE_RPC_URL=https://mainnet.base.org

# ==================== MULTISIG OWNERSHIP ====================
# (Optional) Gnosis Safe address to transfer ownership after deployment
# Set this to enable multisig ownership during deployment
# Example: MULTISIG_ADDRESS=0x1234567890123456789012345678901234567890
MULTISIG_ADDRESS=

# ==================== VERIFICATION KEYS ====================
# Etherscan API key (for Ethereum Sepolia verification)
# Get from: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# BaseScan API key (for Base verification)
# Get from: https://basescan.org/apis
BASESCAN_API_KEY=

# ==================== GAS REPORTER ====================
# Set to "true" to enable gas cost reporting
REPORT_GAS=false

# ==================== COMMON NETWORKS ====================
# Ethereum Mainnet RPC (only for production!)
# MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
